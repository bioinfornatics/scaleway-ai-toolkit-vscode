{
  "name": "scaleway-ai-toolkit-preview",
  "displayName": "Scaleway AI Toolkit \u2014 Preview",
  "description": "Scaleway user browser login, read-only project resources and offline playground.",
  "version": "0.0.34",
  "publisher": "scaleway-ai-community-preview",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=22.6.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:scalewayAI.models",
    "onView:scalewayAI.tools",
    "onView:scalewayAI.help"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Offline demo only; real connections require Workspace Trust."
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "scalewayAI.open",
        "title": "Scaleway AI: Open Offline Preview"
      },
      {
        "command": "scalewayAI.playground",
        "title": "Scaleway AI: Ouvrir le playground mod\u00e8le",
        "icon": "$(play)"
      },
      {
        "command": "scalewayAI.cancel",
        "title": "Scaleway AI: Cancel Demo",
        "icon": "$(debug-stop)"
      },
      {
        "command": "scalewayAI.experiment",
        "title": "Scaleway AI: Open Last Experiment"
      },
      {
        "command": "scalewayAI.catalog",
        "title": "Scaleway AI: Catalogue de d\u00e9monstration",
        "icon": "$(library)"
      },
      {
        "command": "scalewayAI.getStarted",
        "title": "Scaleway AI: Bien d\u00e9marrer"
      },
      {
        "command": "scalewayAI.documentation",
        "title": "Scaleway AI: Documentation Scaleway"
      },
      {
        "command": "scalewayAI.login",
        "title": "Scaleway AI: Se connecter \u00e0 Scaleway",
        "icon": "$(account)"
      },
      {
        "command": "scalewayAI.switchProject",
        "title": "Scaleway AI: Changer de projet",
        "icon": "$(organization)"
      },
      {
        "command": "scalewayAI.loadModels",
        "title": "Scaleway AI: Charger les mod\u00e8les (lecture seule)",
        "icon": "$(refresh)"
      },
      {
        "command": "scalewayAI.disconnect",
        "title": "Scaleway AI: Se d\u00e9connecter"
      },
      {
        "command": "scalewayAI.openCatalog",
        "title": "Scaleway AI: Catalogue de mod\u00e8les"
      },
      {
        "command": "scalewayAI.refreshModels",
        "title": "Scaleway AI: Actualiser catalogues et d\u00e9ploiements",
        "icon": "$(refresh)"
      },
      {
        "command": "scalewayAI.setProject",
        "title": "Scaleway AI: D\u00e9finir le projet Scaleway",
        "icon": "$(organization)"
      },
      {
        "command": "scalewayAI.prepareDeployment",
        "title": "Scaleway AI: Pr\u00e9parer un d\u00e9ploiement d\u00e9di\u00e9 (sans cr\u00e9ation)",
        "icon": "$(server)"
      },
      {
        "command": "scalewayAI.deploymentDetails",
        "title": "Scaleway AI: D\u00e9tails du d\u00e9ploiement (lecture seule)"
      },
      {
        "command": "scalewayAI.saveExperiment",
        "title": "Scaleway AI: Enregistrer l\u2019exp\u00e9rience hors ligne"
      },
      {
        "command": "scalewayAI.loadExperiment",
        "title": "Scaleway AI: Reprendre une exp\u00e9rience hors ligne"
      },
      {
        "command": "scalewayAI.exportExperiment",
        "title": "Scaleway AI: Exporter Python / TypeScript (hors ligne)"
      },
      {
        "command": "scalewayAI.followDeployment",
        "title": "Scaleway AI: Suivre un d\u00e9ploiement existant"
      },
      {
        "command": "scalewayAI.stopDeploymentFollow",
        "title": "Scaleway AI: Arr\u00eater le suivi (ne supprime rien)"
      },
      {
        "command": "scalewayAI.deploymentOperations",
        "title": "Scaleway AI: Lire le journal local des d\u00e9ploiements"
      },
      {
        "command": "scalewayAI.reconcileDeploymentOperation",
        "title": "Scaleway AI: Retrouver une ressource accept\u00e9e (lecture seule)"
      },
      {
        "command": "scalewayAI.inspectQuotas",
        "title": "Scaleway AI: Examiner les quotas de l\u2019organisation (lecture seule)"
      },
      {
        "command": "scalewayAI.inspectModelEula",
        "title": "Scaleway AI: Lire l\u2019EULA d\u2019un mod\u00e8le d\u00e9di\u00e9 (sans acceptation)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "scalewayAI",
          "title": "Scaleway AI",
          "icon": "media/toolkit.svg"
        }
      ]
    },
    "views": {
      "scalewayAI": [
        {
          "id": "scalewayAI.models",
          "name": "Mes ressources"
        },
        {
          "id": "scalewayAI.tools",
          "name": "Outils de d\u00e9veloppement"
        },
        {
          "id": "scalewayAI.help",
          "name": "Aide et retours"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "scalewayAI.setProject",
          "when": "view == scalewayAI.models",
          "group": "navigation"
        },
        {
          "command": "scalewayAI.playground",
          "when": "view == scalewayAI.models",
          "group": "navigation"
        },
        {
          "command": "scalewayAI.cancel",
          "when": "view == scalewayAI.models && scalewayAI.running",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.cjs",
    "package": "npm run check && npm test && vsce package --allow-missing-repository --skip-license --out ../../artifacts/scaleway-ai-toolkit-preview-0.0.34.vsix",
    "check": "biome check --error-on-warnings .",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.19.0",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "5.9.3"
  },
  "icon": "media/scaleway-icon.png"
}
