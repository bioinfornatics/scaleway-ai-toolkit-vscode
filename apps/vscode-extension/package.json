{
  "name": "scaleway-ai-toolkit-preview",
  "displayName": "Scaleway AI Toolkit — Preview",
  "description": "Scaleway browser login with SDK API-key bootstrap, read-only resources and offline playground.",
  "version": "0.0.37",
  "publisher": "scaleway-ai-community-preview",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=22.6.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:scalewayAI.models",
    "onView:scalewayAI.tools",
    "onView:scalewayAI.help"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Offline demo only; real connections require Workspace Trust."
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "scalewayAI.useExistingAPIKey",
        "title": "Scaleway AI: Utiliser une clé API existante"
      },
      {
        "command": "scalewayAI.openModels",
        "title": "Scaleway AI: Ouvrir les clés API (compatibilité)"
      },
      {
        "command": "scalewayAI.openAgents",
        "title": "Scaleway AI: Ouvrir mes agents"
      },
      {
        "command": "scalewayAI.openTools",
        "title": "Scaleway AI: Ouvrir mes tools"
      },
      {
        "command": "scalewayAI.openLocalAgents",
        "title": "Scaleway AI: Ouvrir les bases d’agents locaux"
      },
      {
        "command": "scalewayAI.openLocalTools",
        "title": "Scaleway AI: Ouvrir les bases de tools locaux"
      },
      {
        "command": "scalewayAI.openAgentTemplates",
        "title": "Scaleway AI: Ouvrir mes templates agents"
      },
      {
        "command": "scalewayAI.openToolTemplates",
        "title": "Scaleway AI: Ouvrir mes templates tools"
      },
      {
        "command": "scalewayAI.createAgent",
        "title": "Scaleway AI: Créer un agent"
      },
      {
        "command": "scalewayAI.createTool",
        "title": "Scaleway AI: Créer un tool"
      },
      {
        "command": "scalewayAI.open",
        "title": "Scaleway AI: Open Offline Preview"
      },
      {
        "command": "scalewayAI.playground",
        "title": "Scaleway AI: Ouvrir le playground modèle",
        "icon": "$(play)"
      },
      {
        "command": "scalewayAI.cancel",
        "title": "Scaleway AI: Cancel Demo",
        "icon": "$(debug-stop)"
      },
      {
        "command": "scalewayAI.experiment",
        "title": "Scaleway AI: Open Last Experiment"
      },
      {
        "command": "scalewayAI.catalog",
        "title": "Scaleway AI: Catalogue de démonstration",
        "icon": "$(library)"
      },
      {
        "command": "scalewayAI.getStarted",
        "title": "Scaleway AI: Bien démarrer"
      },
      {
        "command": "scalewayAI.documentation",
        "title": "Scaleway AI: Documentation Scaleway"
      },
      {
        "command": "scalewayAI.login",
        "title": "Scaleway AI: Se connecter à Scaleway",
        "icon": "$(account)"
      },
      {
        "command": "scalewayAI.switchProject",
        "title": "Scaleway AI: Changer de projet",
        "icon": "$(organization)"
      },
      {
        "command": "scalewayAI.loadModels",
        "title": "Scaleway AI: Charger les modèles (lecture seule)",
        "icon": "$(refresh)"
      },
      {
        "command": "scalewayAI.disconnect",
        "title": "Scaleway AI: Se déconnecter"
      },
      {
        "command": "scalewayAI.openCatalog",
        "title": "Scaleway AI: Catalogue de modèles"
      },
      {
        "command": "scalewayAI.refreshModels",
        "title": "Scaleway AI: Actualiser catalogues et déploiements",
        "icon": "$(refresh)"
      },
      {
        "command": "scalewayAI.setProject",
        "title": "Scaleway AI: Définir le projet Scaleway",
        "icon": "$(organization)"
      },
      {
        "command": "scalewayAI.prepareDeployment",
        "title": "Scaleway AI: Préparer un déploiement dédié (sans création)",
        "icon": "$(server)"
      },
      {
        "command": "scalewayAI.deploymentDetails",
        "title": "Scaleway AI: Détails du déploiement (lecture seule)"
      },
      {
        "command": "scalewayAI.saveExperiment",
        "title": "Scaleway AI: Enregistrer l’expérience hors ligne"
      },
      {
        "command": "scalewayAI.loadExperiment",
        "title": "Scaleway AI: Reprendre une expérience hors ligne"
      },
      {
        "command": "scalewayAI.exportExperiment",
        "title": "Scaleway AI: Exporter Python / TypeScript (hors ligne)"
      },
      {
        "command": "scalewayAI.followDeployment",
        "title": "Scaleway AI: Suivre un déploiement existant"
      },
      {
        "command": "scalewayAI.stopDeploymentFollow",
        "title": "Scaleway AI: Arrêter le suivi (ne supprime rien)"
      },
      {
        "command": "scalewayAI.deploymentOperations",
        "title": "Scaleway AI: Lire le journal local des déploiements"
      },
      {
        "command": "scalewayAI.reconcileDeploymentOperation",
        "title": "Scaleway AI: Retrouver une ressource acceptée (lecture seule)"
      },
      {
        "command": "scalewayAI.inspectQuotas",
        "title": "Scaleway AI: Examiner les quotas de l’organisation (lecture seule)"
      },
      {
        "command": "scalewayAI.inspectModelEula",
        "title": "Scaleway AI: Lire l’EULA d’un modèle dédié (sans acceptation)"
      },
      {
        "command": "scalewayAI.revokeAPIKey",
        "title": "Scaleway AI: Révoquer la clé API et se déconnecter"
      },
      {
        "command": "scalewayAI.useServerless",
        "title": "Scaleway AI: Utiliser un modèle Serverless"
      },
      {
        "command": "scalewayAI.deployModel",
        "title": "Scaleway AI: Déployer un modèle dédié"
      },
      {
        "command": "scalewayAI.openService",
        "title": "Scaleway AI: Ouvrir un service"
      },
      {
        "command": "scalewayAI.openAPIKeys",
        "title": "Scaleway AI: Ouvrir les clés API"
      },
      {
        "command": "scalewayAI.openDeployments",
        "title": "Scaleway AI: Ouvrir les déploiements dédiés"
      },
      {
        "command": "scalewayAI.configureAPIKey",
        "title": "Scaleway AI: Ajouter une clé API"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "scalewayAI",
          "title": "Scaleway AI",
          "icon": "media/toolkit.svg"
        }
      ]
    },
    "views": {
      "scalewayAI": [
        {
          "id": "scalewayAI.models",
          "name": "Mes ressources"
        },
        {
          "id": "scalewayAI.tools",
          "name": "Outils de développement"
        },
        {
          "id": "scalewayAI.help",
          "name": "Aide et retours"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "scalewayAI.setProject",
          "when": "view == scalewayAI.models",
          "group": "navigation"
        },
        {
          "command": "scalewayAI.playground",
          "when": "view == scalewayAI.models",
          "group": "navigation"
        },
        {
          "command": "scalewayAI.cancel",
          "when": "view == scalewayAI.models && scalewayAI.running",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "npm run typecheck && node build.mjs",
    "test": "npm run build && node tests/runScoped.mjs",
    "package": "node package.mjs",
    "check": "biome check --error-on-warnings .",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "typecheck": "tsc -p . --noEmit",
    "test:scoped": "node tests/runScoped.mjs",
    "test:full": "npm run build && node tests/runScoped.mjs --full",
    "verify:vsix": "python3 verifyVsix.py"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/mustache": "4.2.6",
    "@types/node": "22.19.0",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "icon": "media/scaleway-icon.png",
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "@scaleway/sdk-client": "2.16.0",
    "@scaleway/sdk-iam": "2.21.3",
    "@scaleway/sdk-inference": "2.20.3",
    "mustache": "4.2.0"
  },
  "overrides": {
    "@scaleway/random-name": "5.1.4"
  }
}
