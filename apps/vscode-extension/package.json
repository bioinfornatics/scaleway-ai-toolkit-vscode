{
  "name": "scaleway-ai-toolkit-preview",
  "displayName": "Scaleway AI Toolkit — Preview",
  "description": "Scaleway user browser login, read-only project resources and offline playground.",
  "version": "0.0.10",
  "publisher": "scaleway-ai-community-preview",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:scalewayAI.models",
    "onView:scalewayAI.tools",
    "onView:scalewayAI.help"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Offline demo only; real connections require Workspace Trust."
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "scalewayAI.open",
        "title": "Scaleway AI: Open Offline Preview"
      },
      {
        "command": "scalewayAI.playground",
        "title": "Scaleway AI: Ouvrir le playground modèle",
        "icon": "$(play)"
      },
      {
        "command": "scalewayAI.cancel",
        "title": "Scaleway AI: Cancel Demo",
        "icon": "$(debug-stop)"
      },
      {
        "command": "scalewayAI.experiment",
        "title": "Scaleway AI: Open Last Experiment"
      },
      {
        "command": "scalewayAI.catalog",
        "title": "Scaleway AI: Catalogue de démonstration",
        "icon": "$(library)"
      },
      {
        "command": "scalewayAI.getStarted",
        "title": "Scaleway AI: Bien démarrer"
      },
      {
        "command": "scalewayAI.documentation",
        "title": "Scaleway AI: Documentation Scaleway"
      },
      {
        "command": "scalewayAI.login",
        "title": "Scaleway AI: Se connecter à Scaleway",
        "icon": "$(account)"
      },
      {
        "command": "scalewayAI.switchProject",
        "title": "Scaleway AI: Changer de projet",
        "icon": "$(organization)"
      },
      {
        "command": "scalewayAI.loadModels",
        "title": "Scaleway AI: Charger les modèles (lecture seule)",
        "icon": "$(refresh)"
      },
      {
        "command": "scalewayAI.disconnect",
        "title": "Scaleway AI: Se déconnecter"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "scalewayAI",
          "title": "Scaleway AI",
          "icon": "media/toolkit.svg"
        }
      ]
    },
    "views": {
      "scalewayAI": [
        {
          "id": "scalewayAI.models",
          "name": "Mes ressources"
        },
        {
          "id": "scalewayAI.tools",
          "name": "Outils de développement"
        },
        {
          "id": "scalewayAI.help",
          "name": "Aide et retours"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "scalewayAI.switchProject",
          "when": "view == scalewayAI.models",
          "group": "navigation"
        },
        {
          "command": "scalewayAI.playground",
          "when": "view == scalewayAI.models",
          "group": "navigation"
        },
        {
          "command": "scalewayAI.cancel",
          "when": "view == scalewayAI.models && scalewayAI.running",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.cjs",
    "package": "npm test && vsce package --allow-missing-repository --skip-license --out ../../artifacts/scaleway-ai-toolkit-preview-0.0.10.vsix"
  },
  "devDependencies": {
    "@types/vscode": "1.96.0",
    "@types/node": "22.19.0",
    "typescript": "5.9.3",
    "@vscode/vsce": "3.7.1"
  },
  "icon": "media/scaleway-icon.png"
}
