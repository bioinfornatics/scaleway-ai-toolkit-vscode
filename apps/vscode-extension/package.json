{
  "name": "scaleway-ai-toolkit-preview",
  "displayName": "Scaleway AI Toolkit — Offline Preview",
  "description": "Experimental community toolkit: native model browser and offline streaming playground. No cloud calls.",
  "version": "0.0.1",
  "publisher": "scaleway-ai-community-preview",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:scalewayAI.models"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Offline synthetic demo only; no workspace execution or network."
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "scalewayAI.open",
        "title": "Scaleway AI: Open Offline Preview"
      },
      {
        "command": "scalewayAI.playground",
        "title": "Scaleway AI: Run Offline Playground"
      },
      {
        "command": "scalewayAI.cancel",
        "title": "Scaleway AI: Cancel Demo"
      },
      {
        "command": "scalewayAI.experiment",
        "title": "Scaleway AI: Open Last Experiment"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "scalewayAI",
          "title": "Scaleway AI",
          "icon": "media/toolkit.svg"
        }
      ]
    },
    "views": {
      "scalewayAI": [
        {
          "id": "scalewayAI.models",
          "name": "Models — Offline Demo"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "scalewayAI.playground",
          "when": "view == scalewayAI.models",
          "group": "navigation"
        },
        {
          "command": "scalewayAI.cancel",
          "when": "view == scalewayAI.models",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.cjs",
    "package": "npm test && vsce package --allow-missing-repository --skip-license --out ../../artifacts/scaleway-ai-toolkit-preview-0.0.1.vsix"
  },
  "devDependencies": {
    "@types/vscode": "1.96.0",
    "@types/node": "22.19.0",
    "typescript": "5.9.3",
    "@vscode/vsce": "3.7.1"
  }
}
