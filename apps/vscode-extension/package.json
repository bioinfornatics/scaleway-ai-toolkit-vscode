{
  "name": "scaleway-ai-toolkit-preview",
  "displayName": "Scaleway AI Toolkit \u2014 Offline Preview",
  "description": "Experimental community toolkit: native model browser and offline streaming playground. No cloud calls.",
  "version": "0.0.2",
  "publisher": "scaleway-ai-community-preview",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:scalewayAI.models",
    "onView:scalewayAI.tools",
    "onView:scalewayAI.help"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Offline synthetic demo only; no workspace execution or network."
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "scalewayAI.open",
        "title": "Scaleway AI: Open Offline Preview"
      },
      {
        "command": "scalewayAI.playground",
        "title": "Scaleway AI: Ouvrir le playground mod\u00e8le",
        "icon": "$(play)"
      },
      {
        "command": "scalewayAI.cancel",
        "title": "Scaleway AI: Cancel Demo",
        "icon": "$(debug-stop)"
      },
      {
        "command": "scalewayAI.experiment",
        "title": "Scaleway AI: Open Last Experiment"
      },
      {
        "command": "scalewayAI.catalog",
        "title": "Scaleway AI: Catalogue de d\u00e9monstration",
        "icon": "$(library)"
      },
      {
        "command": "scalewayAI.getStarted",
        "title": "Scaleway AI: Bien d\u00e9marrer"
      },
      {
        "command": "scalewayAI.documentation",
        "title": "Scaleway AI: Documentation Scaleway"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "scalewayAI",
          "title": "Scaleway AI",
          "icon": "media/toolkit.svg"
        }
      ]
    },
    "views": {
      "scalewayAI": [
        {
          "id": "scalewayAI.models",
          "name": "Mes ressources"
        },
        {
          "id": "scalewayAI.tools",
          "name": "Outils de d\u00e9veloppement"
        },
        {
          "id": "scalewayAI.help",
          "name": "Aide et retours"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "scalewayAI.playground",
          "when": "view == scalewayAI.models",
          "group": "navigation"
        },
        {
          "command": "scalewayAI.cancel",
          "when": "view == scalewayAI.models && scalewayAI.running",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.cjs",
    "package": "npm test && vsce package --allow-missing-repository --skip-license --out ../../artifacts/scaleway-ai-toolkit-preview-0.0.2.vsix"
  },
  "devDependencies": {
    "@types/vscode": "1.96.0",
    "@types/node": "22.19.0",
    "typescript": "5.9.3",
    "@vscode/vsce": "3.7.1"
  }
}
