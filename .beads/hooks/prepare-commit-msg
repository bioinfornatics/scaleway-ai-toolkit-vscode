#!/bin/sh
# Entire CLI hooks
if command -v entire >/dev/null 2>&1; then entire hooks git prepare-commit-msg "$1" "$2" 2>/dev/null || true; else :; fi
# Chain: run pre-existing hook
_entire_hook_dir="$(dirname "$0")"
if [ -z "${ENTIRE_CHAINING_PREPARE_COMMIT_MSG:-}" ]; then
    ENTIRE_CHAINING_PREPARE_COMMIT_MSG=1
    export ENTIRE_CHAINING_PREPARE_COMMIT_MSG
    if [ -n "${PRE_COMMIT_RUNNING_LEGACY:-}" ] && grep -q '^# File generated by pre-commit: https://pre-commit.com' "$_entire_hook_dir/prepare-commit-msg.pre-entire" 2>/dev/null; then
        if [ -x "$_entire_hook_dir/prepare-commit-msg.legacy.pre-entire" ]; then
            "$_entire_hook_dir/prepare-commit-msg.legacy.pre-entire" "$@"
        fi
    elif [ -x "$_entire_hook_dir/prepare-commit-msg.pre-entire" ]; then
        "$_entire_hook_dir/prepare-commit-msg.pre-entire" "$@"
    fi
fi
