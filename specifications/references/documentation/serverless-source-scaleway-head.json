thub.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"d5d2bb9eba8f926ed474a5f22de58555e15fd4fc","url":"https://api.github.com/repos/scaleway/docs-content/commits/d5d2bb9eba8f926ed474a5f22de58555e15fd4fc","html_url":"https://github.com/scaleway/docs-content/commit/d5d2bb9eba8f926ed474a5f22de58555e15fd4fc"}],"stats":{"total":6,"additions":0,"deletions":6},"files":[{"sha":"6d1fdc7fd7a0873c1c1747f78cc643100b2cf3ba","filename":"pages/instances/how-to/tag-instances-hds.mdx","status":"modified","additions":0,"deletions":6,"changes":6,"blob_url":"https://github.com/scaleway/docs-content/blob/1dd79adcf1f8ccbded698d2776871c21d50bac06/pages%2Finstances%2Fhow-to%2Ftag-instances-hds.mdx","raw_url":"https://github.com/scaleway/docs-content/raw/1dd79adcf1f8ccbded698d2776871c21d50bac06/pages%2Finstances%2Fhow-to%2Ftag-instances-hds.mdx","contents_url":"https://api.github.com/repos/scaleway/docs-content/contents/pages%2Finstances%2Fhow-to%2Ftag-instances-hds.mdx?ref=1dd79adcf1f8ccbded698d2776871c21d50bac06","patch":"@@ -11,8 +11,6 @@ import Requirements from '@macros/iam/requirements.mdx'\n \n When hosting healthcare data using Scaleway Instances, you are responsible for knowing which of your resources are HDS-compliant and which are not, as outlined in the [Instances Shared responsibility model](/instances/reference-content/instances-shared-responsibility-model/).\n \n-To identify these resources, you are legally obligated to add the `HDS` tag to every Instance within your HDS scope. This tag is metadata only: it does not change how the Instance works, but it lets you filter, audit, and report on your HDS scope.\n-\n To tag several Instances at once, or to tag Instances from your scripts and automation tools, see [Tag Instances hosting healthcare data using the CLI and API](/instances/api-cli/tag-instances-hds-cli-api/).\n \n <Message type=\"important\">\n@@ -24,10 +22,6 @@ To tag several Instances at once, or to tag Instances from your scripts and auto\n - [Owner](/iam/concepts/glossary/#owner) status or [IAM permissions](/iam/concepts/glossary/#permission) allowing you to perform actions in the intended Organization\n - Signed an HDS contract with Scaleway for the guarantees outlined in the [Shared responsibility model](/instances/reference-content/instances-shared-responsibility-model/) to apply\n \n-## Tag naming convention\n-\n-Use exactly one tag, `HDS`, in uppercase, on all Instances within your HDS scope. Tag filters are case-sensitive and match exact values, so `hds` or `HDS-prod` do not match a filter on `HDS`.\n-\n ## Tag a new Instance\n \n 1. In the **Compute** section of the side menu, click **CPU & GPU Instances**. The Instances page opens."}]}